<!DOCTYPE html>
<html lang="en">
<head>
    <title>ChatConnect</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Segoe+UI:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet prefetch" href="https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css">
    <link rel="stylesheet prefetch" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.6.2/css/font-awesome.min.css">
    <link href="/stylesheets/style.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
</head>
<body>
    <div class="wa-bg"></div>
    <div id="frame">
        <div id="sidepanel">
            <div id="profile">
                <div class="wrap">
                    <img id="profile-img" src="<%= user.img %>" class="online" alt="<%= user.name %>'s profile picture" />
                    <p id="name"><%= user.name %></p>
                    <div class="profile-actions">
                        <% if (featurePermissions.groups) { %>
                        <button type="button" class="icon-btn" id="new-chat-btn" title="New group"><i class="fa fa-users" aria-hidden="true"></i></button>
                        <% } %>
                        <button type="button" class="icon-btn expand-button" title="Profile"><i class="fa fa-ellipsis-v" aria-hidden="true"></i></button>
                    </div>
                    <% if (featurePermissions.presence) { %>
                    <div id="status-options">
                        <ul>
                            <li id="status-online" class="<%= user.status === 'online' ? 'active' : '' %>"><span class="status-circle"></span> <p>Online</p></li>
                            <li id="status-away" class="<%= user.status === 'away' ? 'active' : '' %>"><span class="status-circle"></span> <p>Away</p></li>
                        </ul>
                    </div>
                    <% } %>
                    <div id="expanded">
                        <label for="contact"><i class="fa fa-phone fa-fw" aria-hidden="true"></i></label>
                        <input name="contact" type="text" value="<%= user.contactNo %>" disabled />
                        <form id="profile-picture-form" enctype="multipart/form-data">
                            <label class="profile-picture-label" for="profilePicture">
                                <i class="fa fa-camera fa-fw" aria-hidden="true"></i> Change photo
                            </label>
                            <input id="profilePicture" name="profilePicture" type="file" accept="image/png,image/jpeg,image/gif,image/webp" hidden />
                            <p id="profile-picture-message" role="status" aria-live="polite"></p>
                        </form>
                        <div class="wallet-link-settings">
                            <% if (user.walletAddress) { %>
                                <p>Wallet linked: <code id="wallet-linked-address"><%= user.walletAddress %></code></p>
                            <% } else { %>
                                <button id="wallet-link-button" type="button" class="wallet-link-button">Link wallet for sign-in</button>
                                <p id="wallet-auth-message" role="status" aria-live="polite">Approve a one-time message in your wallet. No transaction is sent.</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <div id="search">
                <label for="chat-search"><i class="fa fa-search" aria-hidden="true"></i></label>
                <input id="chat-search" type="search" placeholder="Search or start a new chat" autocomplete="off" />
            </div>
            <div id="contacts">
                <% if (featurePermissions.groups) { %>
                    <section class="group-section">
                        <div class="group-section-heading">
                            <h2>Private groups</h2>
                            <button type="button" class="icon-btn" id="new-group-action" title="Create a group" aria-label="Create a group">
                                <i class="fa fa-plus" aria-hidden="true"></i>
                            </button>
                        </div>
                        <% if (groupSuccess) { %><p class="group-notice"><%= groupSuccess %></p><% } %>
                        <% if (groupError) { %><p class="group-notice group-error"><%= groupError %></p><% } %>
                        <details class="create-group" id="create-group-details">
                            <summary>Create a private group</summary>
                            <form method="post" action="/groups">
                                <label for="group-name">Group name</label>
                                <input id="group-name" name="name" type="text" maxlength="60" required />
                                <fieldset>
                                    <legend>Add at least one person</legend>
                                    <% contacts.forEach(function (contact) {
                                        if (contact.contactNo !== user.contactNo) { %>
                                            <label class="group-member-option">
                                                <input type="checkbox" name="memberIds" value="<%= contact.id %>" />
                                                <span><%= contact.name %></span>
                                            </label>
                                    <% } }) %>
                                </fieldset>
                                <button type="submit">Create group</button>
                            </form>
                        </details>
                        <ul id="group-list">
                            <% groups.forEach(function (group) { %>
                                <li class="contact group-contact"
                                    data-group-id="<%= group.id %>"
                                    data-group-name="<%= group.name %>"
                                    role="button"
                                    tabindex="0">
                                    <div class="wrap">
                                        <span class="group-avatar"><i class="fa fa-users" aria-hidden="true"></i></span>
                                        <div class="meta">
                                            <div class="meta-top">
                                                <p class="name"><%= group.name %></p>
                                            </div>
                                            <div class="meta-bottom">
                                                <p class="preview">Private group</p>
                                                <span class="unread-badge" hidden>0</span>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            <% }) %>
                        </ul>
                    </section>
                <% } %>
                <% if (featurePermissions.messaging) { %>
                <ul>
                    <% if (typeof contacts !== 'undefined' && contacts.length > 0) { 
                        for (contact of contacts) { 
							if (contact.contactNo !== user.contactNo) {%>
                            <li class="contact" data-contact-no="<%= contact.contactNo %>" onclick="showUserInMainPanel(<%= JSON.stringify(contact) %>)">
                                <div class="wrap">
                                    <span class="contact-status <%= contact.status %>"></span>
                                    <img src="<%= contact.img %>" alt="" />
                                    <div class="meta">
                                        <div class="meta-top">
                                            <p class="name"><%= contact.name %></p>
                                            <span class="chat-time"></span>
                                        </div>
                                        <div class="meta-bottom">
                                            <p id="<%= contact.contactNo %>" class="preview"><%= contact.preview || "Hey there! I am using ChatConnect." %></p>
                                            <span class="unread-badge" hidden>0</span>
                                        </div>
                                    </div>
                                </div>
                            </li>
                    <% } } } %>
                </ul>
                <% } %>
            </div>
            <div id="bottom-bar">
                <% if (featurePermissions.groups) { %>
                <button id="joinroom" type="button">
                    <i class="fa fa-users fa-fw" aria-hidden="true"></i>
                    <span>Group</span>
                </button>
                <% } %>
				<button type="button" onclick="logout()">
					<i class="fa fa-sign-out fa-fw" aria-hidden="true"></i>
					<span>Logout</span>
				</button>
            </div>
        </div>
        <div class="content">
			<div class="container">
				<div class="row justify-content-center">
					<div id="selectChatMessage">
                        <div class="intro-logo">
                            <i class="fa fa-whatsapp" aria-hidden="true"></i>
                        </div>
						<p class="intro-title">ChatConnect for Web</p>
                        <p class="intro-copy">Send and receive messages like WhatsApp. Select a chat to get started.</p>
					</div>
				</div>
			</div>
			<div class="contact-profile">
                <button type="button" class="icon-btn back-chat" id="back-to-chats" title="Back" aria-label="Back to chats">
                    <i class="fa fa-arrow-left" aria-hidden="true"></i>
                </button>
				<img src="<%= user.img %>" alt="" />
				<p>
					<span class="name">Chat</span>
					<span class="small text d-block mt-3 chat-phone"></span>
                    <span class="chat-presence">click here for contact info</span>
				</p>
				<div class="social-media">
                    <button type="button" class="icon-btn" title="Search in chat" id="search-in-chat"><i class="fa fa-search" aria-hidden="true"></i></button>
					<button type="button" class="icon-btn" title="More"><i class="fa fa-ellipsis-v" aria-hidden="true"></i></button>
				</div>
			</div>
			<div class="messages">
				<ul></ul>
                <div id="typing-indicator" hidden>
                    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                </div>
			</div>
            <% if (featurePermissions.messaging || featurePermissions.groups || user.role === 'admin') { %>
			<div class="message-input">
                <div id="emoji-picker" hidden></div>
				<div class="wrap">
                <button type="button" class="icon-btn emoji-toggle" id="emoji-toggle" title="Emoji"><i class="fa fa-smile-o" aria-hidden="true"></i></button>
				<input type="text" id="message-box" placeholder="Type a message" autocomplete="off" />
				<label for="fileInput" class="fa fa-paperclip attachment" aria-hidden="true" title="Attach"></label>
                <input type="file" accept="image/*" id="fileInput" style="display: none;" onchange="selectFile(event)">
				<button class="submit" type="button" title="Send"><i class="fa fa-paper-plane" aria-hidden="true"></i></button>
				</div>
			</div>
            <% } %>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/scripts.js"></script>
    <script src="/javascripts/wallet-auth.js"></script>
    <script src="/javascripts/socket-client.js"></script>
</body>
</html>
